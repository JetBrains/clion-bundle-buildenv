pkgbase=python
pkgname=($pkgbase{,-dev})
pkgver=3.12.16
pkgrel=1
pkgdesc='Interpreted, interactive, object-oriented programming language'
arch=(aarch64 x86_64)
url='https://www.python.org'
license=(PSF)
options=(!staticlibs strip)
depends=(xz)
makedepends=(xz{,-dev})
source=("https://www.python.org/ftp/python/$pkgver/Python-$pkgver.tar.xz")
sha256sums=(b5796915dc45ff745cfb4e990a7e7c93d6f546328a102ce31448d69ebc37575c)

_source_src_subdir="${pkgbase^}-$pkgver"

remove_arch() { sed -E 's/-arch[[:space:]]+[^[:space:]]+//g'; }

build() {
  mkdir -p "$srcdir/build-$CHOST"
  cd "$srcdir/build-$CHOST"

  CFLAGS=$(echo $CFLAGS | remove_arch) \
  CXXFLAGS=$(echo $CXXFLAGS | remove_arch) \
  LDFLAGS=$(echo $LDFLAGS | remove_arch) \
  "../$_source_src_subdir/configure" \
    --prefix="$PREFIX" \
    --enable-shared \
    --disable-optimizations \
    --enable-universalsdk \
    --with-computed-gotos \
    --with-universal-archs=universal2 \
    --without-ensurepip

  install_for_package

  rm -rf "$(temp_destdir)$PREFIX"/lib/python*/ensurepip
}

package_application_with_dev
